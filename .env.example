# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
#
# Convenção do projeto: os valores aqui são escritos na perspectiva do HOST
# (ex.: DATABASE_HOST=localhost). O docker-compose.yml sobrescreve por serviço
# o que precisa apontar para dentro da rede dos containers (ex.: DATABASE_HOST=db).
# Formato: KEY=valor, sem espaços em volta do "=" e sem aspas.

# --- Django ---
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=troque-esta-chave-antes-de-usar
DEBUG=True

# --- PostgreSQL ---
# Em Docker, o banco é criado com estes valores na primeira subida.
DATABASE_NAME=party
DATABASE_USERNAME=party
DATABASE_PASSWORD=party
DATABASE_PORT=5432
DATABASE_HOST=localhost

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0

# --- E-mail ---
# Em dev os e-mails são impressos no console (logs do runserver/worker).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Party API <nao-responda@party.local>

# --- CORS ---
# Origens do front-end autorizadas, separadas por vírgula.
# Atenção: origem é o trio exato scheme+host+porta (localhost != 127.0.0.1).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
